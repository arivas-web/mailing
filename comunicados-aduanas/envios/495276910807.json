          "html": "<h1 style=\"line-height: 125%; font-weight: normal;\">Novedades de la AEAT: medidas fiscales sobre la energía eléctrica, el gas y los carburantes</h1>",
          "lineNumber": 92,
          "module_id": 1155639,
          "parent_widget_container": null,
          "path": "@hubspot/rich_text",
          "schema_version": 2,
          "startPosition": -336
        },
        "child_css": {},
        "css": {},
        "id": "module-1-0-1",
        "label": null,
        "module_id": 1155639,
        "name": "module-1-0-1",
        "order": 3,
        "smart_type": null,
        "styles": {
          "breakpointStyles": {
